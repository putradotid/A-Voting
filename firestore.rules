rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Memastikan pengguna telah terautentikasi melalui Firebase Authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Memastikan email pengguna termasuk dalam whitelist admin yang diizinkan
    // PENTING: Ganti placeholder di bawah dengan email akun admin Firebase aktual Anda
    function isAuthorizedAdmin() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email in [
          'admin@gmail.com'
        ];
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // 1. Koleksi Master Profil Kandidat
    // Akses dibatasi secara eksklusif hanya untuk admin terdaftar
    match /master_candidates/{candidateId} {
      allow read, write: if isAuthorizedAdmin();
    }

    // 2. Koleksi Partisipasi Kandidat dalam Agenda Pemilihan
    // Akses dibatasi secara eksklusif hanya untuk admin terdaftar
    // Dokumen ini memuat perolehan suara (votesCount) dan status verifikasi internal KPU
    match /candidate_participations/{participationId} {
      allow read, write: if isAuthorizedAdmin();
    }

    // 3. Koleksi Agenda Pemilihan (Elections)
    // Tulis dibatasi eksklusif untuk admin terdaftar
    // Dokumen Draft tidak dapat dibaca publik (hanya admin terdaftar)
    // Dokumen non-Draft (Terjadwal, Berlangsung, Selesai) dapat dibaca publik
    match /elections/{electionId} {
      allow read: if isAuthorizedAdmin()
        || (resource != null && resource.data.status in ['Terjadwal', 'Berlangsung', 'Selesai']);
      allow write: if isAuthorizedAdmin();
    }

    // 4. Pengaturan Sistem Global (System Settings)
    // 4a. Referensi Pemilihan Aktif (Eksplisit untuk Dokumen active_election)
    // Publik hanya dapat membaca dokumen ini; tulis dibatasi eksklusif untuk admin terdaftar
    match /system_settings/active_election {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // 4b. Dokumen Pengaturan Sistem Lainnya (e.g. system_metadata)
    // Akses baca dan tulis dibatasi secara eksklusif hanya untuk admin terdaftar
    match /system_settings/{settingId} {
      allow read, write: if isAuthorizedAdmin();
    }

    // 5. Koleksi Data Pemilih Tetap (Election DPT)
    // SANGAT RAHASIA: Akses baca dan tulis dibatasi secara eksklusif hanya untuk admin terdaftar
    match /election_dpt/{dptId} {
      allow read, write: if isAuthorizedAdmin();
    }

    // 6. Koleksi Master Data Mahasiswa (Master Students)
    // SANGAT RAHASIA: Memuat data pribadi mahasiswa (PII); akses dibatasi secara eksklusif hanya untuk admin terdaftar
    match /master_students/{studentNim} {
      allow read, write: if isAuthorizedAdmin();
    }

    // 7. Koleksi Surat Suara Anonim (Election Votes)
    // SANGAT RAHASIA: Seluruh akses baca dan tulis langsung dari browser klien DITOLAK MUTLAK.
    // Hanya dapat dimanipulasi oleh backend server terpercaya melalui Firebase Admin SDK.
    match /election_votes/{voteId} {
      allow read, write: if false;
    }

    // =========================================================================
    // DEFAULT DENY RULE
    // =========================================================================

    // Menolak secara default seluruh operasi baca dan tulis untuk dokumen/koleksi lainnya
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
