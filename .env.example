# Firebase Web App Configuration
# Salin file ini menjadi .env dan isi dengan nilai dari Firebase Console:
# Masuk ke Firebase Console -> Project Settings -> General -> Your apps -> Web app (firebaseConfig)

NUXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NUXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Admin Email Whitelist (Proteksi UI Admin, pisahkan dengan koma jika lebih dari satu)
NUXT_PUBLIC_ADMIN_EMAILS=admin@kampus.ac.id,panitia@kampus.ac.id

# ==============================================================================
# Firebase Admin SDK Configuration (Server-Only, Kredensial Rahasia)
# PENTING: Jangan tambahkan prefix NUXT_PUBLIC_ pada variabel di bawah ini!
# Unduh Service Account dari:
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# ==============================================================================

# Opsi A: Path file Service Account JSON lokal (Direkomendasikan untuk pengembangan lokal)
# Letakkan file JSON di root direktori proyek (otomatis diabaikan oleh .gitignore)
# FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=./service-account.json

# Opsi B: Variabel individual (Direkomendasikan untuk environment staging/production)
# FIREBASE_ADMIN_PROJECT_ID=your_project_id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...==\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# Voter Session Secret (Kunci Tanda Tangan HMAC Cookie Sesi Pemilih)
# ==============================================================================
# VOTER_SESSION_SECRET=generate_random_32_characters_secret_string_here


